[general]
import = ["~/.config/alacritty/catppuccin-mocha.toml"]
live_config_reload = true
working_directory = "None"

[window]
dynamic_padding = true
decorations = "full"
title = "Alacritty"
opacity = 0.8
decorations_theme_variant = "Dark"
option_as_alt = "Both"

[window.dimensions]
columns = 0
lines = 0

[window.class]
instance = "Alacritty"
general = "Alacritty"

[scrolling]
history = 10000
multiplier = 3

[font]
{{- if eq .chezmoi.os "darwin" }}
size = 18
{{- else }}
size = 14
{{- end }}

[font.normal]
family = "UDEV Gothic 35NF"
style = "Regular"

[font.bold]
family = "UDEV Gothic 35NF"
style = "Bold"

[font.italic]
family = "UDEV Gothic 35NF"
style = "Italic"

[font.bold_italic]
family = "UDEV Gothic 35NF"
style = "Bold Italic"

[selection]
semantic_escape_chars = ",│`|:\"' ()[]{}<>\t"
save_to_clipboard = true

[cursor]
style = "Underline"
vi_mode_style = "None"
unfocused_hollow = true
thickness = 0.15

[mouse]
hide_when_typing = true

[[mouse.bindings]]
mouse = "Middle"
action = "PasteSelection"

[keyboard]
[[keyboard.bindings]]
key = "V"
mods = "Control|Shift"
action = "Paste"

[[keyboard.bindings]]
key = "C"
mods = "Control|Shift"
action = "Copy"

[[keyboard.bindings]]
key = "N"
mods = "Control|Shift"
action = "CreateNewWindow"

[[keyboard.bindings]]
key = "F"
mods = "Control|Shift"
action = "ToggleFullscreen"

[[keyboard.bindings]]
key = "Key0"
mods = "Control"
action = "ResetFontSize"
