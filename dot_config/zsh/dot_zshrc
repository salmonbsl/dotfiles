# keymap
bindkey -v
bindkey '^[;' autosuggest-accept

# zsh-abbr
ABBR_SET_EXPANSION_CURSOR=1
ABBR_GET_AVAILABLE_ABBREVIATION=1
ABBR_LOG_AVAILABLE_ABBREVIATION=1
ABBR_LOG_AVAILABLE_ABBREVIATION_AFTER=1

# plugin manager
eval "$(sheldon source)"

# zsh-autosuggestions-abbreviations-strategy
ZSH_AUTOSUGGEST_STRATEGY=( abbreviations $ZSH_AUTOSUGGEST_STRATEGY )

# basics
abbr -S -q ..='cd ..'
abbr -S -q ...='cd ../../'
abbr -S -q nv='nvim'

if command -v nix-collect-garbage >/dev/null 2>&1; then
  abbr -S -q ncg='nix-collect-garbage -d'
fi

# ls
alias ls='ls --color=auto'
if command -v eza >/dev/null 2>&1; then
  alias eza='eza --icons=auto --group-directories-first'

  # -F をつけるとパス補完ができなくなるのではずす
  abbr -S -q l='eza'
  abbr -S -q la='eza -a'
  abbr -S -q ll='eza -lah'
else
  abbr -S -q l='ls -F'
  abbr -S -q la='ls -aF'
  abbr -S -q ll='ls -lahF'
fi

# docker
abbr -S -q d='docker'
abbr -S -q dc='docker compose'
abbr -S -q dcu='docker compose up'
abbr -S -q dcud='docker compose up -d'
abbr -S -q dcd='docker compose down'
abbr -S -q dcp='docker compose ps'
abbr -S -q dcl='docker compose logs'
abbr -S -q dce='docker compose exec'
abbr -S -q dcr='docker compose restart'

# git
abbr -S -q g='git'
abbr -S -q ga='git add'
abbr -S -q ga.='git add .'
abbr -S -q gcm='git commit -m "%"'
abbr -S -q gco='git checkout %'
abbr -S -q gst='git status'
abbr -S -q gl='git log --oneline --graph --decorate --all'
abbr -S -q gf='git fetch'
abbr -S -q gp='git pull'
abbr -S -q gP='git push'
abbr -S -q gsw='git switch'

# chezmoi
abbr -S -q cz='chezmoi'
abbr -S -q cza='chezmoi -v apply'
abbr -S -q czad='chezmoi add'
abbr -S -q czd='chezmoi diff'
abbr -S -q czs='chezmoi status'
abbr -S -q cze='chezmoi edit'
abbr -S -q czc='chezmoi cd'
abbr -S -q czu='chezmoi -v update'

# history
HISTFILE="$XDG_STATE_HOME/zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt hist_expire_dups_first
setopt hist_ignore_all_dups
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt inc_append_history
setopt share_history

# completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# starchip
eval "$(starship init zsh)"

# zoxide
eval "$(zoxide init zsh)"

# fzf
source <(fzf --zsh)

export PATH="$HOME/.local/bin:$PATH"
export EDITOR="nvim"

# Homebrew
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
fi
